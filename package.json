{
    "name": "resq",
    "version": "2.0.0",
    "description": "React Element Selector Query (resq) - Query React components and children by selector (component name)",
    "keywords": [
        "react",
        "selector",
        "resq",
        "rescue",
        "queryselector",
        "query"
    ],
    "author": "Baruch Velez <baruchvelez@gmail.com>",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "unpkg": "./dist/index.global.js",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "bugs": {
        "url": "https://github.com/baruchvlz/resq/issues"
    },
    "repository": {
        "url": "https://github.com/baruchvlz/resq"
    },
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "bench": "vitest bench --run",
        "docs:dev": "npm run docs:api && vitepress dev docs",
        "docs:build": "npm run docs:api && vitepress build docs",
        "docs:api": "typedoc",
        "docs:preview": "vitepress preview docs"
    },
    "dependencies": {
        "fast-deep-equal": "^3.1.3"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^4.1.12",
        "eslint": "^10.14.0",
        "jsdom": "^29.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tsup": "^8.5.1",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.14.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitepress": "^1.6.4",
        "vitest": "^4.1.12"
    }
}
